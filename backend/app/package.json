{
  "name": "velox",
  "version": "1.0.0",
  "description": "Velox Academy API",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node main.js",
    "dev": "nodemon -L main.js",
    "test": "NODE_ENV=test jest --runInBand",
    "db:migrate": "node scripts/db.js migrate",
    "db:rollback": "node scripts/db.js rollback",
    "db:rollback:all": "node scripts/db.js rollback --all",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset",
    "db:status": "node scripts/db.js status",
    "db:make-admin": "node scripts/db.js make-admin"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/compute": "^4.5.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.0.1",
    "objection": "^3.1.4",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./test/globalSetup.js",
    "testTimeout": 20000,
    "setupFiles": [
      "./test/setupEnv.js"
    ]
  }
}
