# Copy to .env and adjust. Every variable is optional in development.

# --- Server ---------------------------------------------------------------
# PORT=5001
# NODE_ENV=development
# Comma-separated origins allowed to call the API with cookies.
# CORS_ORIGINS=http://localhost:3000
# Set when running behind a reverse proxy, e.g. 1
# TRUST_PROXY=

# --- Authentication -------------------------------------------------------
# Required in production. Generate one with: openssl rand -hex 32
# JWT_SECRET=
# JWT_EXPIRES_IN=24h
# SESSION_MAX_AGE_HOURS=24
# Defaults to true in production (HTTPS only cookies).
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# Login / register / password change attempts per IP per 15 minutes.
# AUTH_RATE_LIMIT_MAX=20

# --- Database (see docs/database.md) -----------------------------------------
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/velox
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=velox
# DB_USER=postgres
# DB_PASSWORD=postgres
# SEED_ON_START=true
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Sandboxes ----------------------------------------------------------------
# gcp (Compute Engine VM per learner), local (shared vm-image service) or
# disabled. Defaults to local in development and gcp in production.
# SANDBOX_PROVIDER=local
# SANDBOX_PORT=9000
# local provider: URL the browser uses to reach vm-image, and its SANDBOX_TOKEN.
# LOCAL_SANDBOX_URL=http://localhost:9000
# LOCAL_SANDBOX_TOKEN=
# gcp provider
# GCP_PROJECT_ID=
# GCP_ZONE=europe-west1-b
# GCP_INSTANCE_TEMPLATE=velox-images-sql-101
# GOOGLE_APPLICATION_CREDENTIALS=/app/application_default_credentials.json
